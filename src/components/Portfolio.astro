---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
---

<section id="work">
  <div class="inner">
    <div class="heading">
      <div class="intro">
        <div class="eyebrow">Proyectos recientes y en camino</div>
        <h2>Algunos negocios que ya están creciendo en línea con nuestra ayuda.</h2>
      </div>
      <span class="aside">El tuyo podría ser el siguiente →</span>
    </div>

    <div class="grid">
      {
        projects.map((project) => (
          <article class:list={['card', { linked: !!project.url }]}>
            <div class="thumb">
              {project.image ? (
                <Image src={project.image} alt={project.imageAlt ?? project.name} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 400px" />
              ) : (
                <span>Reservado para ti</span>
              )}
            </div>
            <div class="body">
              <div class="meta">
                <span class="tag">{project.tag}</span>
                <span class="dot">·</span>
                <span class="status">{project.status}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.blurb}</p>
              {project.url && (
                <a class="visit" href={project.url} target="_blank" rel="noopener noreferrer">
                  Ver sitio ↗
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background: var(--sand);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(56px, 7vw, 104px) var(--pad-x);
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(32px, 4vw, 52px);
  }

  .intro {
    max-width: 520px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary);
    font-weight: 600;
    margin-bottom: 16px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .aside {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-faint);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 22px;
  }

  .card {
    background: #fff;
    border: 1px solid rgba(184, 175, 163, 0.5);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .card.linked {
    position: relative;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .card.linked:hover,
  .card.linked:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(46, 42, 36, 0.1);
    border-color: var(--stone);
  }

  .card.linked:hover .visit,
  .card.linked:focus-within .visit {
    color: var(--accent);
  }

  .card.linked:hover .thumb img {
    transform: scale(1.03);
  }

  /* Placeholder rayado mientras no hay imagen real del proyecto */
  .thumb {
    aspect-ratio: 16 / 11;
    background-image: repeating-linear-gradient(
      135deg,
      rgba(184, 175, 163, 0.18) 0 11px,
      transparent 11px 22px
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.3s ease;
  }

  .thumb span {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-faint);
    border: 1px dashed var(--stone);
    padding: 5px 11px;
    border-radius: 7px;
    background: var(--cream);
  }

  .body {
    padding: 18px 20px 20px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 7px;
  }

  .tag {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dot {
    font-size: 11.5px;
    color: var(--stone);
  }

  .status {
    font-size: 12px;
    color: var(--ink-faint);
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 6px;
  }

  p {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 0;
  }

  .visit {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .visit::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
