---
import { projects } from '../data/projects';
---

<section id="work">
  <div class="inner">
    <div class="heading">
      <div class="intro">
        <div class="eyebrow">Proyectos recientes y en camino</div>
        <h2>Algunos negocios que ya están creciendo en línea con nuestra ayuda.</h2>
      </div>
      <span class="aside">El tuyo podría ser el siguiente →</span>
    </div>

    <div class="grid">
      {
        projects.map((project) => (
          <article class="card">
            <div class="thumb">
              <span>imagen del proyecto</span>
            </div>
            <div class="body">
              <div class="meta">
                <span class="tag">{project.tag}</span>
                <span class="dot">·</span>
                <span class="status">{project.status}</span>
              </div>
              <h3>{project.name}</h3>
              <p>{project.blurb}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background: var(--sand);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(56px, 7vw, 104px) var(--pad-x);
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(32px, 4vw, 52px);
  }

  .intro {
    max-width: 520px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary);
    font-weight: 600;
    margin-bottom: 16px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .aside {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-faint);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 22px;
  }

  .card {
    background: #fff;
    border: 1px solid rgba(184, 175, 163, 0.5);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Placeholder rayado mientras no hay imagen real del proyecto */
  .thumb {
    aspect-ratio: 16 / 11;
    background-image: repeating-linear-gradient(
      135deg,
      rgba(184, 175, 163, 0.18) 0 11px,
      transparent 11px 22px
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb span {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-faint);
    border: 1px dashed var(--stone);
    padding: 5px 11px;
    border-radius: 7px;
    background: var(--cream);
  }

  .body {
    padding: 18px 20px 20px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 7px;
  }

  .tag {
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dot {
    font-size: 11.5px;
    color: var(--stone);
  }

  .status {
    font-size: 12px;
    color: var(--ink-faint);
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 6px;
  }

  p {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 0;
  }
</style>
