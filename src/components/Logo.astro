---
// El monograma "P con raíces" dentro del chip verde.
// Se usa en el header (38px), la foto polaroid (30px) y el footer (32px):
// una sola fuente de verdad, la prop `size` lo escala.
interface Props {
  size?: number; // lado del chip cuadrado, en px
}

const { size = 38 } = Astro.props;

// Proporciones tomadas del diseño (chip de 38px → ícono de 21×26, radio 9)
const iconWidth = Math.round(size * 0.55);
const iconHeight = Math.round(size * 0.68);
const radius = Math.round(size * 0.24);
---

<span class="chip" style={`width:${size}px; height:${size}px; border-radius:${radius}px;`}>
  <svg
    viewBox="-46 -12 114 158"
    width={iconWidth}
    height={iconHeight}
    fill="none"
    stroke="currentColor"
    stroke-width="14"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M0 0 L0 130"></path>
    <path d="M0 0 Q56 0, 56 34 Q56 68, 0 68"></path>
    <path d="M0 96 C-20 106, -32 118, -38 132" stroke-width="6"></path>
    <path d="M0 100 C0 112, 0 122, 0 134" stroke-width="6"></path>
    <path d="M0 96 C20 106, 32 118, 38 132" stroke-width="6"></path>
  </svg>
</span>

<style>
  .chip {
    background: var(--secondary);
    color: var(--cream); /* el SVG usa stroke="currentColor" → hereda este color */
    display: grid;
    place-items: center;
    flex: none;
  }
</style>
