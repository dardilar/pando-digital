---
interface Props {
  size?: number;
  variant?: "verde" | "claro";
  class?: string;
}

const { size = 40, variant = "verde", class: className = "" } = Astro.props;

const theme = {
  verde: { fondo: "#2F5D4F", letra: "#FFFBF5", punto: "#E8663D" },
  claro: { fondo: "#FFFBF5", letra: "#2F5D4F", punto: "#E8663D" },
}[variant];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={className}
  role="img"
  aria-label="Pando Digital"
>
  <rect width="64" height="64" rx="14" fill={theme.fondo} />
  <g transform="translate(20 8) scale(0.4)">
    <path d="M8 8 L8 120" fill="none" stroke={theme.letra} stroke-width="16" />
    <path d="M8 8 Q53 8 53 35 Q53 62 8 62" fill="none" stroke={theme.letra} stroke-width="16" />
    <rect x="28" y="106" width="14" height="14" rx="3" fill={theme.punto} />
  </g>
</svg>

<style>
  svg {
    display: block;
  }
</style>