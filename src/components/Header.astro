---
import Logo from './Logo.astro';

const links = [
  { href: '#services', label: 'Servicios' },
  { href: '#about', label: 'Nosotros' },
  { href: '#work', label: 'Proyectos' },
  { href: '#faq', label: 'FAQ' },
];
---

<header>
  <div class="inner">
    <a href="#top" class="brand">
      <Logo size={38} />
      <span class="wordmark">Pando Digital</span>
    </a>
    <details class="menu-toggle">
      <summary aria-label="Abrir menú de navegación"></summary>
    </details>
    <nav>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="#contact" class="cta">Empecemos</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 251, 245, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(184, 175, 163, 0.4);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 16px var(--pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  nav a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
  }

  nav a.cta {
    background: var(--accent);
    color: var(--cream);
    font-weight: 700;
    font-size: 14.5px;
    padding: 10px 18px;
    border-radius: 10px;
  }

  /* En escritorio el interruptor no existe; el nav se muestra siempre. */
  .menu-toggle {
    display: none;
  }

  @media (max-width: 720px) {
    .menu-toggle {
      display: block;
    }

    .menu-toggle summary {
      list-style: none; /* quita la flechita nativa de <summary> */
      cursor: pointer;
      font-size: 24px;
      line-height: 1;
      padding: 4px 8px;
      color: var(--ink);
      user-select: none;
    }

    .menu-toggle summary::-webkit-details-marker {
      display: none;
    }

    .menu-toggle summary::before {
      content: '☰';
    }

    .menu-toggle[open] summary::before {
      content: '✕';
    }

    /* El nav sale del flujo del header y se despliega como panel debajo. */
    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: rgba(255, 251, 245, 0.97);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(184, 175, 163, 0.4);
      padding: 8px var(--pad-x) 20px;
    }

    .menu-toggle[open] + nav {
      display: flex;
    }

    nav a {
      padding: 12px 0;
      font-size: 16px;
    }

    nav a.cta {
      margin-top: 8px;
      text-align: center;
    }
  }
</style>

<script>
  // Cierra el menú móvil al elegir un link; si no, el panel taparía la sección.
  const toggle = document.querySelector('.menu-toggle');
  document.querySelectorAll('header nav a').forEach((link) => {
    link.addEventListener('click', () => toggle?.removeAttribute('open'));
  });
</script>
