---
import Logo from './Logo.astro';

const links = [
  { href: '#services', label: 'Servicios' },
  { href: '#about', label: 'Nosotros' },
  { href: '#work', label: 'Proyectos' },
  { href: '#faq', label: 'FAQ' },
];
---

<header>
  <div class="inner">
    <a href="#top" class="brand">
      <Logo size={38} />
      <span class="wordmark">Pando Digital</span>
    </a>
    <nav>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="#contact" class="cta">Empecemos</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 251, 245, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(184, 175, 163, 0.4);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 16px var(--pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  nav a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
  }

  nav a.cta {
    background: var(--accent);
    color: var(--cream);
    font-weight: 700;
    font-size: 14.5px;
    padding: 10px 18px;
    border-radius: 10px;
  }
</style>
