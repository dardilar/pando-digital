---
import { faqs } from '../data/faqs';
---

<section id="faq">
  <div class="intro">
    <div class="eyebrow">Preguntas frecuentes</div>
    <h2>Preguntas que suelen hacernos antes de empezar.</h2>
    <p>¿No ves tu pregunta aquí? Escríbenos en el formulario. Ninguna pregunta es demasiado básica.</p>
  </div>

  <div class="list">
    {
      faqs.map((faq) => (
        <details>
          <summary>
            {faq.q}
            <span class="icon" aria-hidden="true" />
          </summary>
          <p>{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  section {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(56px, 7vw, 104px) var(--pad-x);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 5vw, 72px);
    align-items: flex-start;
  }

  .intro {
    flex: 0 1 360px;
    min-width: 280px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary);
    font-weight: 600;
    margin-bottom: 16px;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .intro p {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 32em;
    margin: 0;
  }

  .list {
    flex: 1 1 440px;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  details {
    background: #fff;
    border: 1px solid rgba(184, 175, 163, 0.5);
    border-radius: 14px;
    overflow: hidden;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    padding: clamp(18px, 2.4vw, 24px);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.3;
    /* oculta la flechita nativa del navegador: el ícono lo ponemos nosotros */
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* El círculo +/–: su aspecto depende del estado open del <details> */
  .icon {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(232, 102, 61, 0.12);
    color: var(--accent);
    display: grid;
    place-items: center;
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 1;
  }

  .icon::before {
    content: '+';
  }

  details[open] .icon {
    background: var(--accent);
    color: var(--cream);
  }

  details[open] .icon::before {
    content: '–';
  }

  details > p {
    margin: 0;
    padding: 0 clamp(18px, 2.4vw, 24px) clamp(20px, 2.6vw, 26px);
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
  }
</style>
